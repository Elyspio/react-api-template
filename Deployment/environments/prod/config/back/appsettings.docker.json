{
  "ConnectionStrings": {
    "MongoDB": "mongodb://root:root@example.com:27017/admin",
    "Redis": "redis.example.com:6379,password=change-me"
  },
  "Keycloak": {
    "Realm": "react-api-template",
    "Audience": "react-api-template-api"
  },
  "services": {
    "keycloak": {
      "https": ["https://elyspio.fr/auth"]
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://elyspio.fr"]
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "System": "Warning"
      }
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
  "OTEL_SERVICE_NAME": "react-api-template"
}
