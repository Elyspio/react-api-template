{
	"ConnectionStrings": {
		"MongoDB": "mongodb://root:root@example.com:27017/admin",
		"Redis": "example.com:6379"
	},
	"Keycloak": {
		"Realm": "react-api-template",
		"Audience": "react-api-template-api"
	},
	"JokeApi": {
		"BaseUrl": "https://v2.jokeapi.dev/",
		"Categories": "Programming,Misc,Pun"
	},
	"AllowedHosts": "*",
	"Serilog": {
		"MinimumLevel": {
			"Default": "Debug",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.Hosting.Lifetime": "Information",
				"Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
				"System": "Warning"
			}
		}
	}
}
