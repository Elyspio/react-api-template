		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
		<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
		<PackageReference Include="Scalar.AspNetCore" />
		<PackageReference Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" />
		<PackageReference Include="ZiggyCreatures.FusionCache.OpenTelemetry" />
		<PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Example.Api.Abstractions\Example.Api.Abstractions.csproj" />
		<ProjectReference Include="..\Example.Api.Adapters.Mongo\Example.Api.Adapters.Mongo.csproj" />
		<ProjectReference Include="..\Example.Api.Adapters.Rest\Example.Api.Adapters.Rest.csproj" />
		<ProjectReference Include="..\Example.Api.Core\Example.Api.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Example.Api.Tests" />
	</ItemGroup>

</Project>
